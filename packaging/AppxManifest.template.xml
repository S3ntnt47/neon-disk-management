<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX manifest for Neon Disk Management. package.ps1 fills the {{TOKENS}}.
  The identity values must match Partner Center > your app > Product management > Product identity.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="{{IDENTITY_NAME}}"
    Publisher="{{PUBLISHER}}"
    Version="{{VERSION}}"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Neon Disk Management</DisplayName>
    <PublisherDisplayName>{{PUBLISHER_DISPLAY_NAME}}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Shrink, extend, create and delete partitions in a simple interface.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="NeonDiskManagement" Executable="Disks.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Neon Disk Management"
        Description="Shrink, extend, create and delete partitions in a simple interface."
        BackgroundColor="#0c0a17"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" Square310x310Logo="Assets\Square310x310Logo.png" ShortName="Disk Management">
          <uap:ShowNameOnTiles>
            <uap:ShowOn Tile="square150x150Logo" />
          </uap:ShowNameOnTiles>
        </uap:DefaultTile>
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#0c0a17" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <!-- classic desktop (Win32) app -->
    <rescap:Capability Name="runFullTrust" />
    <!-- lets the app relaunch itself as administrator to change partitions (needs Store approval) -->
    <rescap:Capability Name="allowElevation" />
  </Capabilities>
</Package>
